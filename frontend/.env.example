# Where the UI gets its data.
#   mock — (default) synthetic demo data built into the frontend. No backend
#          needed; every header shows a "Demo data" badge.
#   api  — the real backend at VITE_API_BASE_URL (Aiden's API, connected by
#          Firas). See docs/frontend/BACKEND-INTEGRATION.md.
VITE_DATA_SOURCE=mock

# Base URL of the real backend, used only when VITE_DATA_SOURCE=api.
# Example for a backend running locally: http://127.0.0.1:8080
VITE_API_BASE_URL=
