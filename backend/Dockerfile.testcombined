# TEST-ONLY combined image: Postgres + FastAPI in one container.
# Not for real Week3 deployment - no data persistence across restarts.
# Purpose: unblock Code Engine testing (raw Postgres TCP isn't servable
# as its own Code Engine app - see docs/evidence/ for the writeup).
FROM postgres:16

RUN apt-get update && \
    apt-get install -y --no-install-recommends python3 python3-pip python3-venv supervisor && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN python3 -m venv /venv
ENV PATH="/venv/bin:$PATH"

COPY requirements.txt .
RUN pip install --no-cache-dir "setuptools<81" wheel && \
    pip install --no-cache-dir --no-build-isolation -r requirements.txt

COPY app ./app
COPY schemas/db_schema.sql /docker-entrypoint-initdb.d/db_schema.sql
COPY schemas/seed_test_data.sql /docker-entrypoint-initdb.d/z_seed_test_data.sql
COPY supervisord.conf /etc/supervisor/conf.d/supervisord.conf

ENV POSTGRES_PASSWORD=devpassword
ENV POSTGRES_DB=rcs_infra
ENV DATABASE_URL=postgresql://postgres:devpassword@localhost:5432/rcs_infra

EXPOSE 8080

CMD ["supervisord", "-n", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
