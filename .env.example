# IBM Cloud / watsonx
IBM_CLOUD_API_KEY=
IBM_CLOUD_REGION=
IBM_CLOUD_RESOURCE_GROUP=

# watsonx governance
WATSONX_GOVERNANCE_URL=
WATSONX_GOVERNANCE_SERVICE_INSTANCE_ID=

# watsonx.ai
WATSONX_PROJECT_ID=
WATSONX_URL=
WATSONX_API_KEY=
WATSONX_VISION_MODEL_ID=

# watson Speech to Text
SPEECH_TO_TEXT_API_KEY=
SPEECH_TO_TEXT_URL=
SPEECH_TO_TEXT_MODEL=en-AU

# IBM Cloud Object Storage
COS_ENDPOINT=
COS_BUCKET_NAME=
COS_INSTANCE_CRN=

# watsonx Orchestrate
WATSONX_ORCHESTRATE_URL=
WATSONX_ORCHESTRATE_BEARER_TOKEN=
WATSONX_ORCHESTRATE_TIMEOUT_SECONDS=10

# local PostgreSQL development container
POSTGRES_DB=rcs_infra
POSTGRES_USER=rcs_app
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

# sqlalchemy connection used by database
DATABASE_URL=postgresql+psycopg2://rcs_app:change-me-local-only@localhost:5432/rcs_infra

# application
APP_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:5173

# "mock" runs the same selector locally; "remote" calls the URL above.
ORCHESTRATE_MODE=mock

# upload storage. Use "cos" only after the COS values above are set.
VIDEO_STORAGE_BACKEND=local
VIDEO_STORAGE_DIRECTORY=/tmp/ibm-rcs-uploads

# required for the temporary POST /api/internal/.../mock-ai-result endpoint.
INTERNAL_API_KEY=replace-with-a-long-random-development-key
